PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/rasbhav_books_v3

# Generate 32 random bytes and store as a 64-character hex secret; keep private
ADMIN_MFA_ENCRYPTION_KEY=

# Resend transactional email (keep real values in Codespaces Secrets, never commit them)
RESEND_API_KEY=
EMAIL_FROM=Rasbhav Books <noreply@example.com>

# Razorpay test mode only (keep real credentials in Codespaces Secrets, never commit them)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 private object storage (S3-compatible API; keep real keys in Codespaces Secrets)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Private ClamAV daemon required before uploads can be accepted
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
